// Cadence user interface.
//
// Logic lives in Rust (crates/app/src/gui.rs); this file only lays out the
// window and forwards user actions through callbacks.

import { Button, CheckBox, Palette, AboutSlint, VerticalBox } from "std-widgets.slint";

export enum RunStatus { stopped, waiting, running, error }

export struct HotkeyRow {
    label: string,
    binding: string,
    problem: string,
    bound: bool,
}

global Theme {
    out property <color> running: #0f7b0f;
    out property <color> waiting: #b26a00;
    out property <color> error: #c42b1c;
    out property <color> idle: Palette.foreground.transparentize(55%);
    out property <color> muted: Palette.foreground.transparentize(35%);
    out property <length> gap: 10px;
    out property <length> card-padding: 14px;
}

component Card inherits Rectangle {
    in property <string> title;
    background: Palette.alternate-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border.transparentize(40%);
    VerticalLayout {
        padding: Theme.card-padding;
        spacing: 8px;
        if root.title != "": VerticalLayout {
            spacing: 6px;
            Text {
                text: root.title;
                font-size: 12px;
                font-weight: 600;
                color: Theme.muted;
            }
            // Subtle divider between the heading and the section's controls.
            Rectangle {
                height: 1px;
                background: Palette.border.transparentize(30%);
            }
        }
        @children
    }
}

component Message inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.error;
    in property <bool> dismissable: false;
    callback dismissed;
    background: root.tone.transparentize(88%);
    border-radius: 6px;
    border-width: 1px;
    border-color: root.tone.transparentize(60%);
    layout := HorizontalLayout {
        padding: 8px;
        spacing: 8px;
        Text {
            text: root.text;
            wrap: word-wrap;
            color: Palette.foreground;
            font-size: 12px;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        if root.dismissable: Button {
            text: "Dismiss";
            clicked => { root.dismissed(); }
        }
    }
}

// A single-line numeric text field. Fluent's LineEdit always shows a clear
// ("X") button while focused, which is unnecessary here: selecting the value
// and typing replaces it. Editing, Enter and focus behave as in LineEdit.
component NumberField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    callback edited();
    callback accepted();
    public function focus-input() {
        input.focus();
    }
    min-height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.border;
    background: root.enabled ? Palette.control-background : Palette.control-background.transparentize(60%);
    clip: true;
    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        enabled: root.enabled;
        single-line: true;
        input-type: decimal;
        horizontal-alignment: right;
        vertical-alignment: center;
        color: root.enabled ? Palette.control-foreground : Theme.idle;
        selection-background-color: Palette.selection-background;
        selection-foreground-color: Palette.selection-foreground;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
    }
    // Focus indicator, like Fluent's text fields.
    if input.has-focus: Rectangle {
        x: 1px;
        y: parent.height - 2px;
        width: parent.width - 2px;
        height: 2px;
        background: Palette.accent-background;
    }
}

component FieldRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;
    in property <string> unit;
    in property <bool> enabled: true;
    /// The unit is a clickable toggle (e.g. ms / CPS).
    in property <bool> unit-toggles;
    in-out property <string> value;
    callback edited();
    callback commit();
    callback unit-clicked();
    public function focus-input() {
        edit.focus-input();
    }
    spacing: 10px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 1px;
        Text {
            text: root.label;
            color: root.enabled ? Palette.foreground : Theme.idle;
        }
        if root.description != "": Text {
            text: root.description;
            color: root.enabled ? Theme.muted : Theme.idle;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        spacing: 6px;
        alignment: end;
        VerticalLayout {
            alignment: center;
            edit := NumberField {
                text <=> root.value;
                enabled: root.enabled;
                width: 80px;
                edited => { root.edited(); }
                accepted => { root.commit(); }
                // Also fires when focus moves elsewhere: another field, a tab,
                // or the window background (see `focus-sink` in MainWindow).
                changed has-focus => {
                    if !self.has-focus { root.commit(); }
                }
            }
        }
        if !root.unit-toggles: Text {
            text: root.unit;
            vertical-alignment: center;
            color: root.enabled ? Theme.muted : Theme.idle;
            width: 30px;
        }
        if root.unit-toggles: Rectangle {
            width: 30px;
            unit-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.unit-clicked(); }
            }
            Text {
                text: root.unit;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
                height: parent.height;
                // Accent colour marks it as clickable; brighter on hover.
                color: unit-area.has-hover ? Palette.accent-background.brighter(20%) : Palette.accent-background;
            }
            // Thin underline, like a link.
            Rectangle {
                x: 0;
                y: parent.height / 2 + 8px;
                width: unit-text-width.preferred-width;
                height: 1px;
                background: unit-area.has-hover ? Palette.accent-background.brighter(20%) : Palette.accent-background.transparentize(40%);
            }
            unit-text-width := Text {
                visible: false;
                text: root.unit;
            }
        }
    }
}

// A two-option segmented control: both options always visible, the active one
// filled with the accent colour. Clicking an option selects it immediately.
//
// Keyboard: one Tab stop (like a radio group); Left/Right switch, Home/End
// go to the first or last option. A focus ring marks the active option while
// the control has keyboard focus. Mouse clicks do not focus it.
component SegmentedControl inherits FocusScope {
    in property <[string]> options;
    in property <int> selected;
    in property <string> label;
    callback select(int);
    focus-on-click: false;
    accessible-role: radio-group;
    accessible-label: root.label;
    key-pressed(event) => {
        if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
            return reject;
        }
        if event.text == Key.LeftArrow && root.selected > 0 {
            root.select(root.selected - 1);
            return accept;
        }
        if event.text == Key.RightArrow && root.selected < root.options.length - 1 {
            root.select(root.selected + 1);
            return accept;
        }
        if event.text == Key.LeftArrow || event.text == Key.RightArrow {
            return accept;
        }
        if event.text == Key.Home {
            root.select(0);
            return accept;
        }
        if event.text == Key.End {
            root.select(root.options.length - 1);
            return accept;
        }
        reject
    }
    Rectangle {
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.border;
        background: Palette.control-background;
        HorizontalLayout {
            padding: 2px;
            spacing: 2px;
            for option[index] in root.options: Rectangle {
                horizontal-stretch: 1;
                min-height: 28px;
                border-radius: 4px;
                accessible-role: radio-button;
                accessible-label: option;
                accessible-checkable: true;
                accessible-checked: root.selected == index;
                accessible-action-default => { root.select(index); }
                background: root.selected == index ? Palette.accent-background : transparent;
                // Keyboard focus ring on the active option.
                border-width: root.has-focus && root.selected == index ? 2px : 0px;
                border-color: Palette.foreground;
                segment-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.select(index); }
                }
                Text {
                    text: option;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-weight: root.selected == index ? 600 : 400;
                    color: root.selected == index ? Palette.accent-foreground
                        : segment-area.has-hover ? Palette.foreground : Theme.muted;
                }
            }
        }
    }
}

export component AboutWindow inherits Window {
    in property <string> version;
    callback close-clicked();
    title: "About Cadence";
    icon: @image-url("../../../assets/icon/icon-256.png");
    min-width: 380px;
    preferred-width: 380px;
    VerticalBox {
        padding: 20px;
        spacing: 10px;
        alignment: start;
        Text {
            text: "Cadence";
            font-size: 22px;
            font-weight: 700;
        }
        Text {
            text: "Version " + root.version;
            color: Theme.muted;
        }
        Text {
            text: "A desktop autoclicker with precise, configurable click timing, human-like variation, clicking at a fixed position or at the cursor, and global hotkeys.";
            wrap: word-wrap;
        }
        Text {
            text: "Licensed under the MIT License.";
            color: Theme.muted;
            font-size: 12px;
        }
        AboutSlint {
            min-height: 150px;
            max-height: 190px;
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "Close";
                primary: true;
                clicked => { root.close-clicked(); }
            }
        }
    }
}

export component MainWindow inherits Window {
    // ---- state from Rust ----
    in property <string> window-title: "Cadence";
    in property <RunStatus> status: RunStatus.stopped;
    in property <string> status-headline: "Stopped";
    in property <string> error-text;
    in property <string> notice-text;
    in property <string> config-warning;
    /// The toggle hotkey ("" if unbound), shown on the Start/Stop button.
    in property <string> toggle-key;
    in-out property <bool> fixed-mode: true;
    in property <string> target-text: "Not set";
    /// A position is being picked (the next click on screen sets it).
    in property <bool> picking;
    in-out property <string> interval-text;
    in-out property <string> jitter-text;
    in-out property <string> hold-text;
    in-out property <string> radius-text;
    in property <bool> interval-in-cps;
    in property <string> settings-error;
    in property <bool> settings-pending;
    in property <[HotkeyRow]> hotkeys;
    in-out property <int> current-tab: 0;
    /// Whether the tab bar has keyboard focus (read by the GUI tests).
    out property <bool> tab-bar-focused: tab-bar.has-focus;
    in-out property <int> capturing-index: -1;
    in property <string> hotkeys-error;
    in-out property <bool> keep-on-top;

    // ---- user actions ----
    callback start-stop-clicked();
    callback mode-selected(bool);
    callback pick-target-clicked();
    callback settings-edited();
    callback settings-commit();
    callback interval-unit-clicked();
    callback hotkey-record(int);
    callback hotkey-key(string, bool, bool, bool);
    callback hotkey-cancel();
    callback hotkey-clear(int);
    callback keep-on-top-toggled(bool);
    callback about-clicked();
    callback open-logs-clicked();
    callback exit-clicked();
    callback warning-dismissed();
    // ---- wake-ups from worker threads (invoked via the event loop) ----
    callback status-ready();
    callback exit-requested();
    callback show-requested();
    callback pick-decided();

    /// Whether the mode control has keyboard focus (read by the GUI tests).
    out property <bool> mode-control-focused: mode-control.has-focus;
    /// The coordinate display next to Pick target.
    out property <string> coordinates-text: "Coordinates: " + root.target-text;
    /// "Pick target" is only available in Fixed position mode.
    out property <bool> pick-enabled: root.fixed-mode;

    /// Puts keyboard focus into the Interval field (used by the GUI tests).
    public function focus-interval-field() {
        interval-row.focus-input();
    }

    /// Moves keyboard focus off any edited field (which commits it).
    public function release-field-focus() {
        focus-sink.focus();
    }

    public function start-recording(index: int) {
        root.capturing-index = index;
        key-capture.focus();
        root.hotkey-record(index);
    }

    title: root.window-title;
    icon: @image-url("../../../assets/icon/icon-256.png");
    always-on-top: root.keep-on-top;
    min-width: 400px;
    preferred-width: 420px;
    background: Palette.background;

    // Behind all content: clicking any non-interactive area (card backgrounds,
    // labels, padding) gives the focus to this scope, so a timing field being
    // edited loses focus and commits through its `changed has-focus` handler.
    // Buttons do not take focus when clicked; their actions commit pending
    // edits in Rust before running.
    focus-sink := FocusScope {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        focus-on-tab-navigation: false;
    }

    // Captures the next key while a hotkey is being recorded.
    key-capture := FocusScope {
        x: 0; y: 0; width: 0; height: 0;
        enabled: root.capturing-index >= 0;
        key-pressed(event) => {
            if root.capturing-index < 0 { return reject; }
            if event.repeat { return accept; }
            root.hotkey-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
            accept
        }
        changed has-focus => {
            if !self.has-focus && root.capturing-index >= 0 {
                root.hotkey-cancel();
            }
        }
    }

    VerticalLayout {
        padding: 14px;
        spacing: Theme.gap;

        if root.config-warning != "": Message {
            text: root.config-warning;
            tone: Theme.waiting;
            dismissable: true;
            dismissed => { root.warning-dismissed(); }
        }

        // ---- status and main action ----
        Card {
            HorizontalLayout {
                spacing: 12px;
                alignment: stretch;
                Rectangle {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 7px;
                    background: root.status == RunStatus.running ? Theme.running
                        : root.status == RunStatus.waiting ? Theme.waiting
                        : root.status == RunStatus.error ? Theme.error : Theme.idle;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.status-headline;
                        font-size: 20px;
                        font-weight: 700;
                        color: root.status == RunStatus.error ? Theme.error : Palette.foreground;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: (root.status == RunStatus.running || root.status == RunStatus.waiting ? "Stop" : "Start")
                            + (root.toggle-key != "" ? " (" + root.toggle-key + ")" : "");
                        primary: true;
                        min-width: 120px;
                        clicked => { root.start-stop-clicked(); }
                    }
                }
            }
            if root.error-text != "": Message { text: root.error-text; }
        }
        // Problem notices (e.g. Start without a position), below the status
        // card. The line only exists while there is a notice; no space is
        // reserved for it otherwise.
        if root.notice-text != "": Text {
            text: root.notice-text;
            color: Theme.muted;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: center;
        }

        // Tab bar with centred labels (the standard TabWidget left-aligns
        // them). Clicking a tab moves the focus off an edited field first, so
        // the field commits as before.
        //
        // Keyboard: the bar is a single Tab stop (like a standard tab list);
        // Left/Right switch between the two tabs, Home/End go to the first or
        // last one. A focus ring marks the active tab while the bar has
        // keyboard focus. Reaching the bar with Tab moves the focus off an
        // edited field, which commits it. Mouse clicks do not focus the bar.
        tab-bar := FocusScope {
            focus-on-click: false;
            accessible-role: tab-list;
            accessible-item-count: 2;
            key-pressed(event) => {
                if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                    return reject;
                }
                if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                    root.current-tab = root.current-tab == 0 ? 1 : 0;
                    return accept;
                }
                if event.text == Key.Home {
                    root.current-tab = 0;
                    return accept;
                }
                if event.text == Key.End {
                    root.current-tab = 1;
                    return accept;
                }
                reject
            }
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    for title[index] in ["Settings", "Hotkeys"]: Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        border-radius: 4px;
                        accessible-role: tab;
                        accessible-label: title;
                        accessible-item-index: index;
                        accessible-item-selectable: true;
                        accessible-item-selected: root.current-tab == index;
                        // Keyboard focus ring on the active tab.
                        border-width: tab-bar.has-focus && root.current-tab == index ? 2px : 0px;
                        border-color: Palette.foreground;
                        tab-area := TouchArea {
                            clicked => {
                                root.release-field-focus();
                                root.current-tab = index;
                            }
                        }
                        Text {
                            text: title;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: root.current-tab == index ? 600 : 400;
                            // Hover only brightens the label; the active tab
                            // stays marked by weight and the accent underline.
                            color: root.current-tab == index || tab-area.has-hover
                                ? Palette.foreground : Theme.muted;
                        }
                        if root.current-tab == index: Rectangle {
                            y: parent.height - 3px;
                            x: (parent.width - 32px) / 2;
                            width: 32px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: Palette.accent-background;
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Palette.border.transparentize(40%);
                }
            }
        }

        // Both pages occupy the same area, which is as tall as the larger
        // one, so the window size does not change between tabs. The hidden
        // page is invisible and takes no input.
        Rectangle {
            vertical-stretch: 1;
            min-height: max(settings-page.preferred-height, hotkeys-page.preferred-height);
            min-width: max(settings-page.min-width, hotkeys-page.min-width);
            settings-page := VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                visible: root.current-tab == 0;
                padding-top: 10px;
                    spacing: Theme.gap;
                    alignment: start;
                    Card {
                        title: "TARGET";
                        mode-control := SegmentedControl {
                            label: "Click position";
                            options: ["Fixed position", "Current position"];
                            selected: root.fixed-mode ? 0 : 1;
                            select(index) => {
                                // A click (not a key press) moves the focus off an
                                // edited field, which commits it.
                                if !self.has-focus { root.release-field-focus(); }
                                root.mode-selected(index == 0);
                            }
                        }
                        // The saved position stays visible (and is kept) in both
                        // modes; it is only used, and can only be picked, in
                        // Fixed position mode.
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.coordinates-text;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                                color: root.fixed-mode ? Palette.foreground : Theme.idle;
                            }
                            Button {
                                text: root.picking ? "Cancel" : "Pick target";
                                enabled: root.pick-enabled;
                                min-width: 96px;
                                clicked => { root.pick-target-clicked(); }
                            }
                        }
                        Text {
                            text: root.picking
                                ? "Click to set the position. Right-click to cancel."
                                : root.fixed-mode
                                    ? "Clicks at the saved position. Use Pick target to change it."
                                    : "Clicks wherever the cursor is. The cursor is never moved.";
                            font-weight: root.picking ? 600 : 400;
                            color: root.picking ? Palette.foreground : Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    Card {
                        title: "TIMING";
                        interval-row := FieldRow {
                            label: "Interval";
                            description: "Time between consecutive click starts.";
                            unit: root.interval-in-cps ? "CPS" : "ms";
                            unit-toggles: true;
                            unit-clicked => { root.interval-unit-clicked(); }
                            value <=> root.interval-text;
                            edited => { root.settings-edited(); }
                            commit => { root.settings-commit(); }
                        }
                        FieldRow {
                            label: "Interval jitter (σ)";
                            description: "Adds random variation to the interval between clicks.";
                            unit: "ms";
                            value <=> root.jitter-text;
                            edited => { root.settings-edited(); }
                            commit => { root.settings-commit(); }
                        }
                        FieldRow {
                            label: "Hold duration";
                            description: "How long the mouse button stays pressed for each click.";
                            unit: "ms";
                            value <=> root.hold-text;
                            edited => { root.settings-edited(); }
                            commit => { root.settings-commit(); }
                        }
                        FieldRow {
                            label: "Position jitter";
                            description: "Randomly offsets the click position within the configured radius. Fixed position mode only.";
                            unit: "px";
                            enabled: root.fixed-mode;
                            value <=> root.radius-text;
                            edited => { root.settings-edited(); }
                            commit => { root.settings-commit(); }
                        }
                        if root.settings-error != "": Message { text: root.settings-error; }
                        if root.settings-pending && root.settings-error == "": Text {
                            text: "Press Enter or leave the field to apply.";
                            color: Theme.muted;
                            font-size: 11px;
                        }
                    }
                }
            hotkeys-page := VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                visible: root.current-tab == 1;
                padding-top: 10px;
                spacing: Theme.gap;
                alignment: start;
                // All bindings in one card, separated by subtle dividers.
                Card {
                    for row[index] in root.hotkeys: VerticalLayout {
                        spacing: 8px;
                        if index > 0: Rectangle {
                            height: 1px;
                            background: Palette.border.transparentize(30%);
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text { text: row.label; }
                                if row.problem != "": Text {
                                    text: row.problem;
                                    color: Theme.error;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                            Button {
                                text: root.capturing-index == index ? "Press keys…" : row.binding;
                                primary: root.capturing-index == index;
                                min-width: 132px;
                                clicked => {
                                    if root.capturing-index == index {
                                        root.hotkey-cancel();
                                    } else {
                                        root.start-recording(index);
                                    }
                                }
                            }
                            Button {
                                text: "Clear";
                                enabled: row.bound && root.capturing-index < 0;
                                clicked => { root.hotkey-clear(index); }
                            }
                        }
                    }
                }
                if root.hotkeys-error != "": Message { text: root.hotkeys-error; }
                if root.capturing-index >= 0: Text {
                    text: "Press the new key combination, or Esc to cancel. If nothing happens, another program already uses that combination.";
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            CheckBox {
                text: "Always on top";
                checked <=> root.keep-on-top;
                toggled => { root.keep-on-top-toggled(self.checked); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Logs";
                clicked => { root.open-logs-clicked(); }
            }
            Button {
                text: "About";
                clicked => { root.about-clicked(); }
            }
            Button {
                text: "Exit";
                clicked => { root.exit-clicked(); }
            }
        }
    }
}

// Notification-area icon. Closing the main window hides it; the tray keeps
// the application reachable and offers an explicit Exit.
export component AppTray inherits SystemTrayIcon {
    in property <bool> running;
    in property <bool> window-visible: true;
    callback show-window();
    callback toggle-window();
    callback start-stop();
    callback open-logs();
    callback exit();

    icon: root.running ? @image-url("../../../assets/icon/tray-running.png") : @image-url("../../../assets/icon/tray-idle.png");
    tooltip: root.running ? "Cadence - running" : "Cadence - stopped";
    title: "Cadence";
    clicked => { root.show-window(); }

    Menu {
        MenuItem {
            title: root.window-visible ? "Hide window" : "Show window";
            activated => { root.toggle-window(); }
        }
        MenuItem {
            title: root.running ? "Stop clicking" : "Start clicking";
            activated => { root.start-stop(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Open log folder";
            activated => { root.open-logs(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Exit";
            activated => { root.exit(); }
        }
    }
}
